<Window x:Class="Dungeons2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Dungeons2.ViewModels"
        xmlns:views="clr-namespace:Dungeons2.Views"
        xmlns:local="clr-namespace:Dungeons2"
        mc:Ignorable="d" Title="Dungeons" Height="840" Width="1230"
        WindowStartupLocation="CenterScreen"
        Background="#121212" Foreground="#E0E0E0">
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ButtonBorder" Background="Transparent" Padding="20,15">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1F1F22"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="GroupName" Value="Menu"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#18181A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,20,0,0">
                    <TextBlock Text="Dungeons" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,10,20,40"/>
                    <RadioButton Content="🏠  Home" Style="{StaticResource SidebarButtonStyle}" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="Home"/>

                    <RadioButton Content="🗂️  Floor History" Style="{StaticResource SidebarButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="FloorHistory"/>

                    <RadioButton Content="📝  Log" Style="{StaticResource SidebarButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Log"/>

                    <RadioButton Content="📊  Stats" Style="{StaticResource SidebarButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Stats"/>

                    <RadioButton Content="🛠  Settings" Style="{StaticResource SidebarButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#1F1F22" Padding="20" BorderBrush="#2D2D30" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Target Process" Foreground="#888888" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Height="28" 
                                      ItemsSource="{Binding AvailableProcesses}" 
                                      SelectedItem="{Binding SelectedProcess}"
                                      Background="#2D2D30" Foreground="Black" Padding="5,4"
                                      ToolTip="Select the game client to hook into"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Margin="30" Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
                    <views:HomeView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:FloorHistoryViewModel}">
                    <views:FloorHistoryView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:LogViewModel}">
                    <views:LogView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:StatsViewModel}">
                    <views:StatsView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
                    <views:SettingsView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
