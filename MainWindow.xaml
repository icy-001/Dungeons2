<Window x:Class="Dungeons2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dungeons2"
        mc:Ignorable="d"
        Title="Dungeons" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center">
            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="10">
                <ComboBox VerticalAlignment="Center" x:Name="RSWindowComboBox" Width="255" ItemsSource="{Binding RSWindows}" SelectedItem="{Binding SelectedWindow}"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"><Hyperlink NavigateUri="Maps" RequestNavigate="Hyperlink_RequestNavigate">Maps</Hyperlink></TextBlock>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"><Hyperlink NavigateUri="Winterfaces" RequestNavigate="Hyperlink_RequestNavigate">Winterfaces</Hyperlink></TextBlock>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"><Hyperlink NavigateUri="floors.txt" RequestNavigate="Hyperlink_RequestNavigate">Floor log</Hyperlink></TextBlock>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Center">
                <CheckBox x:Name="LogSheetsCheckBox" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="{Binding LogToSheet}">Log times to Google Sheets</CheckBox>
                <Label Margin="10,0,0,0">Spreadsheet ID:</Label>
                <TextBox VerticalAlignment="Center" Text="{Binding SpreadsheetId}"  Width="300"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="HistoryGrid" ItemsSource="{Binding FloorHistory}"
                  AutoGenerateColumns="False" Margin="10,5,10,5" CanUserSortColumns="False" CopyingRowClipboardContent="HistoryGrid_CopyingRowClipboardContent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                        Binding="{Binding Id}" 
                        Width="SizeToHeader" />

                <DataGridTextColumn Header="Timestamp" 
                        Binding="{Binding Timestamp, StringFormat=\{0:g\}}" 
                        Width="120" />

                <DataGridTextColumn Header="Teammates" 
                        Binding="{Binding Teammates}" 
                        Width="60" />

                <DataGridTextColumn Header="Floor" 
                        Binding="{Binding FloorNumber}" 
                        Width="30" />

                <DataGridTextColumn Header="Size" 
                        Binding="{Binding Size}" 
                        Width="40" />

                <DataGridTextColumn Header="Time" 
                        Binding="{Binding Time}" 
                        Width="60" />

                <DataGridTextColumn Header="Bonus" 
                        Binding="{Binding Bonus, StringFormat=\{0:P1\}}" 
                        Width="50" />

                <DataGridTextColumn Header="Mobs Mod" 
                        Binding="{Binding MobsKilledMod}" 
                        Width="40" />

                <DataGridTextColumn Header="Boost" 
                        Binding="{Binding Boost}" 
                        Width="30" />

                <DataGridTextColumn Header="Total Mod" 
                        Binding="{Binding TotalMod}" 
                        Width="40" />

                <DataGridTextColumn Header="Total XP" 
                        Binding="{Binding TotalXP, StringFormat=\{0:N0\}}" 
                        Width="60" />

                <DataGridTextColumn Header="RC" 
                        Binding="{Binding RoomCount}" 
                        Width="40" />

                <DataGridTextColumn Header="DE" 
                        Binding="{Binding DeadEnds}" 
                        Width="40" />
                <DataGridTextColumn Header="Notes" 
                        Binding="{Binding Notes}" 
                        Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Row="2" x:Name="LogTextBox" Margin="10,5,10,10" TextWrapping="Wrap" IsReadOnly="True" FontFamily="Cascadia Code" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
