<UserControl x:Class="Dungeons2.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212" Foreground="#E0E0E0">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15,10,15,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Section: Live Floor Map (Fixed 280x280 view, No layers) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Live Floor Map" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border x:Name="MapStatusBorder" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1E291B"/>
                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DungeonStore.IsMapFound}" Value="False">
                                        <Setter Property="Background" Value="#2B1D1D"/>
                                        <Setter Property="BorderBrush" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Foreground="{Binding BorderBrush, ElementName=MapStatusBorder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="●"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DungeonStore.IsMapFound}" Value="False">
                                                <Setter Property="Text" Value="✕"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding BorderBrush, ElementName=MapStatusBorder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Map connected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DungeonStore.IsMapFound}" Value="False">
                                                <Setter Property="Text" Value="Map not connected"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border x:Name="KeybagStatusBorder" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1E291B"/>
                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DungeonStore.IsKeybagFound}" Value="False">
                                        <Setter Property="Background" Value="#2B1D1D"/>
                                        <Setter Property="BorderBrush" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Foreground="{Binding BorderBrush, ElementName=KeybagStatusBorder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="●"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DungeonStore.IsKeybagFound}" Value="False">
                                                <Setter Property="Text" Value="✕"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding BorderBrush, ElementName=KeybagStatusBorder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="HUD connected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DungeonStore.IsKeybagFound}" Value="False">
                                                <Setter Property="Text" Value="HUD not connected"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#18181A" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" Padding="10">
                <Image Width="280" Height="280" Source="{Binding DungeonStore.MapImage}"/>
            </Border>
        </Grid>

        <!-- Separator -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#2D2D30" Margin="0,5"/>

        <!-- Bottom Section: History & Details -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="Floor History" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                    <Hyperlink Click="FloorsHyperlink_Click" Foreground="#4DA6FF" TextDecorations="Underline">
                        Raw floor log ↗️
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="349*"/>
                    <ColumnDefinition Width="158*"/>
                </Grid.ColumnDefinitions>

                <!-- Compact History List -->
                <Border Grid.Column="0" Background="#18181A" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" Margin="0,0,15,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding FloorHistory}"
                                  SelectedItem="{Binding SelectedFloor}"
                                  FontSize="13"
                                  Background="Transparent" 
                                  BorderThickness="0" 
                                  Foreground="#E0E0E0" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="{Binding FloorNumber}" 
                                                   Foreground="White"
                                                   TextAlignment="Right"
                                                   Width="20"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Text="{Binding Time, StringFormat={}{0:m\\:ss}}" 
                                                   Foreground="#4DA6FF"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold" 
                                                   Width="40"/>

                                        <TextBlock Foreground="#888">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="5-man"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TeamSize}" Value="1">
                                                            <Setter Property="Text" Value="Solo"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamSize}" Value="2">
                                                            <Setter Property="Text" Value="Duo"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamSize}" Value="3">
                                                            <Setter Property="Text" Value="Trio"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamSize}" Value="4">
                                                            <Setter Property="Text" Value="4-man"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamSize}" Value="5">
                                                            <Setter Property="Text" Value="5-man"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
                <!-- Detailed Panel Layout -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Textual Metadata Metrics -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0" DataContext="{Binding SelectedFloor}">
                            <TextBlock Text="Floor Details" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Floor # -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Floor #" Foreground="#888" FontSize="13" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FloorNumber}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- Size -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Foreground="#888" FontSize="13" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Size}" Foreground="White" FontSize="14" Margin="0,0,0,12"/>

                                <!-- Time -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Time" Foreground="#888" FontSize="13" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Time, StringFormat={}{0:m\\:ss}}" Foreground="#4DA6FF" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Bonus Rooms -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bonus Rooms" Foreground="#888" FontSize="13" Margin="0,0,0,15"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Bonus, StringFormat={}{0:P0}}" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                                <!-- Winterface File Link -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Winterface File" Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                                <Button Grid.Row="4" Grid.Column="1" Content="Open ↗" Background="Transparent" Foreground="#4DA6FF" BorderThickness="0" FontSize="13" Cursor="Hand" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>

                        <!-- Static 280x280 Rendered Historical Map Container -->
                        <Border Grid.Column="1" Width="280" Height="280" Background="#141416" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                            <Image Width="280" Height="280" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>