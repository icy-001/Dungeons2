<UserControl x:Class="Dungeons2.Views.FloorHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dungeons2">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:TimeSpanToTotalMinutesConverter x:Key="TimeSpanToTotalMinutesConverter"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Floor History" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                <Hyperlink Click="FloorsHyperlink_Click" Foreground="#4DA6FF" TextDecorations="Underline">
                    Raw floor log ↗️
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="349*"/>
                <ColumnDefinition Width="158*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#18181A" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,6" VerticalAlignment="Center">
                        <TextBlock Text="Team size" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="100"
                                  ItemsSource="{Binding TeamSizeFilterOptions}"
                                  SelectedItem="{Binding SelectedTeamSizeFilter, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="6,4">
                        </ComboBox>
                    </StackPanel>

                    <ListBox x:Name="FloorHistoryListBox" Grid.Row="1" ItemsSource="{Binding FilteredFloorHistory}"
                             SelectedItem="{Binding SelectedFloor}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontSize="13"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock Text="{Binding FloorNumber}"
                                           Foreground="White"
                                           TextAlignment="Right"
                                           Width="20"
                                           Margin="0,0,10,0" />

                                <TextBlock Text="{Binding Time, Converter={StaticResource TimeSpanToTotalMinutesConverter}}"
                                           Foreground="#4DA6FF"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"
                                           Width="50"/>

                                <TextBlock Foreground="#888" Width="50" Text="{Binding PartySizeLabel}" />
                                <TextBlock Foreground="#888" Text="{Binding Size}" Width="60" />
                                <TextBlock Foreground="#888" Text="{Binding Bonus, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" DataContext="{Binding SelectedFloor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                        <TextBlock Text="Floor Details" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="LabelStyle" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="DockPanel.Dock" Value="Left"/>
                                    <Setter Property="Width" Value="140"/>
                                </Style>
                                <Style x:Key="ValueStyle" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </StackPanel.Resources>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Timestamp" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:G}}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Floor #" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding FloorNumber}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Time" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Time, StringFormat={}{0:m\\:ss}}" Style="{StaticResource ValueStyle}" Foreground="#4DA6FF" FontWeight="Bold"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Team size" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding PartySizeLabel}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Size" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Size}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Bonus Rooms" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Bonus, StringFormat={}{0:P0}}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Mobs Killed (%)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding MobsKilledMod}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Room count" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding RoomCount}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Dead ends" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding DeadEnds}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12" Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Dead ends with key" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding DeadEndCountExtended.Dewks}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12" Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Dead ends w/o key" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding DeadEndCountExtended.Denks}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Skill doors" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding SkillDoors}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Skill door ticks" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding SkillDoorTicks}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Possible puzzle rooms" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding PossiblePuzzleRooms}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Key count" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding KeyCount}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12" Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Critical rooms" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding CriticalRoomCount}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12" Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Critical keys" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding CriticalKeyCount}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12" Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Depth" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Depth}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="RPM" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Rpm, StringFormat={}{0:F2}}" Style="{StaticResource ValueStyle}"/>
                            </DockPanel>

                            <DockPanel>
                                <TextBlock Text="Winterface File" Style="{StaticResource LabelStyle}"/>
                                <Button Content="Open ↗" Background="Transparent" Foreground="#4DA6FF" BorderThickness="0"
                                        Cursor="Hand" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenWinterfaceCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DockPanel>

                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#141416" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                        <StackPanel>
                            <Image Width="280" Height="280" Source="{Binding AnnotatedMapImage}" />
                            <Border Background="#1A1A1D" Padding="12,10" BorderBrush="#2D2D30" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="Overlay" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <CheckBox Content="Show opened keydoors"
                                              IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowKeydoors, Mode=TwoWay}"
                                              Foreground="#E0E0E0"
                                              FontSize="12"
                                              Margin="0,0,0,6"/>
                                    <CheckBox Content="Show key locations"
                                              IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowKeyLocations, Mode=TwoWay}"
                                              Foreground="#E0E0E0"
                                              FontSize="12"
                                              Margin="0,0,0,6"/>
                                    <CheckBox Content="Hide trivial keyblocks"
                                              IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=HideTrivialKeyblocks, Mode=TwoWay}"
                                              Foreground="#E0E0E0"
                                              FontSize="12"
                                              Margin="0,0,0,6"/>
                                    <CheckBox Content="Show room ticks"
                                              IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowRoomTicks, Mode=TwoWay}"
                                              Foreground="#E0E0E0"
                                              FontSize="12"
                                              Margin="0,0,0,6"/>
                                    <CheckBox Content="Show player visited overlay"
                                              IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowPlayerVisitedOverlay, Mode=TwoWay}"
                                              Foreground="#E0E0E0"
                                              FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
