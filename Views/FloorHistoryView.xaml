<UserControl x:Class="Dungeons2.Views.FloorHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dungeons2">
    <UserControl.Resources>
        <local:TimeSpanToTotalMinutesConverter x:Key="TimeSpanToTotalMinutesConverter"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Floor History" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                <Hyperlink Click="FloorsHyperlink_Click" Foreground="#4DA6FF" TextDecorations="Underline">
                    Raw floor log ↗️
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="349*"/>
                <ColumnDefinition Width="158*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#18181A" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" Margin="0,0,15,0">
                <ListBox ItemsSource="{Binding DungeonStore.FloorHistory}"
                         SelectedItem="{Binding SelectedFloor}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontSize="13"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock Text="{Binding FloorNumber}"
                                           Foreground="White"
                                           TextAlignment="Right"
                                           Width="20"
                                           Margin="0,0,10,0" />

                                <TextBlock Text="{Binding Time, Converter={StaticResource TimeSpanToTotalMinutesConverter}}"
                                           Foreground="#4DA6FF"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"
                                           Width="50"/>

                                <TextBlock Foreground="#888" Width="40">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TeamSize}" Value="1">
                                                    <Setter Property="Text" Value="Solo"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TeamSize}" Value="2">
                                                    <Setter Property="Text" Value="Duo"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TeamSize}" Value="3">
                                                    <Setter Property="Text" Value="Trio"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TeamSize}" Value="4">
                                                    <Setter Property="Text" Value="4-man"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TeamSize}" Value="5">
                                                    <Setter Property="Text" Value="5-man"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Foreground="#888" Text="{Binding Size}" Width="60" />
                                <TextBlock Foreground="#888" Text="{Binding Bonus, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" DataContext="{Binding SelectedFloor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                        <TextBlock Text="Floor Details" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Floor #" Foreground="#888" FontSize="13" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FloorNumber}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Foreground="#888" FontSize="13" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Size}" Foreground="White" FontSize="14" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Time" Foreground="#888" FontSize="13" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Time, StringFormat={}{0:m\\:ss}}" Foreground="#4DA6FF" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bonus Rooms" Foreground="#888" FontSize="13" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Bonus, StringFormat={}{0:P0}}" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Room count" Foreground="#888" FontSize="13" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RoomCount}" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Dead ends" Foreground="#888" FontSize="13" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DeadEnds}" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Winterface File" Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                            <Button Grid.Row="6" Grid.Column="1" Content="Open ↗" Background="Transparent" Foreground="#4DA6FF" BorderThickness="0" FontSize="13" Cursor="Hand" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Width="280" Height="280" Background="#141416" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                        <Image Width="280" Height="280" Stretch="Uniform" Source="{Binding MapImage}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
