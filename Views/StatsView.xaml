<UserControl x:Class="Dungeons2.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:Dungeons2.ViewModels">
  <UserControl.Resources>
    <Style x:Key="ChartListStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="VirtualizingPanel.CacheLength" Value="0"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThemeButtonStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#BBBBBB"/>
      <Setter Property="Background" Value="#252529"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#35353A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#234567"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Foreground" Value="#4DA6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTabStyle" TargetType="TabItem">
      <Setter Property="Foreground" Value="#999999"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Cursor="Hand">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4DA6FF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Foreground" Value="#4DA6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type viewmodels:FloorMetricHistogram}">
      <Border Background="#1E1E1E" CornerRadius="8" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Average:" Foreground="#888" FontSize="13" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Average, StringFormat={}{0:F2}}" Foreground="White" FontSize="13"/>
            <TextBlock Text="   Std Dev:" Foreground="#888" FontSize="13" Margin="12,0,8,0"/>
            <TextBlock Text="{Binding StandardDeviation, StringFormat={}{0:F2}}" Foreground="White" FontSize="13"/>
            <TextBlock Text="{Binding ThemeCounts}" Foreground="#888" FontSize="13" Margin="20,0,0,0"/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding HistogramBars}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Width="18" Margin="2,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" VerticalAlignment="Bottom" Height="{Binding BarHeight}" Background="#4DA6FF" CornerRadius="4,4,0,0"/>
                  <TextBlock Grid.Row="1" Text="{Binding CountLabel}" Foreground="#E0E0E0" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Text="{Binding Label}" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:FloorTimeCdfPlot}">
      <Border Background="#1E1E1E" CornerRadius="8" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Detail}" Foreground="#888" FontSize="13" Margin="0,5,0,12"/>
          <Grid Width="520" Height="300" Margin="0,4,0,0">
            <Border Background="#141416"/>
            <Canvas Width="520" Height="300"
                    Background="Transparent"
                    MouseMove="FloorTimeCdfCanvas_MouseMove"
                    MouseLeave="FloorTimeCdfCanvas_MouseLeave">
              <Line X1="52" Y1="16" X2="52" Y2="262" Stroke="#666" StrokeThickness="1"/>
              <Line X1="52" Y1="262" X2="504" Y2="262" Stroke="#666" StrokeThickness="1"/>
              <Line X1="52" Y1="139" X2="504" Y2="139" Stroke="#333" StrokeThickness="1" StrokeDashArray="3,3"/>
              <Polyline Points="{Binding CdfPoints}" Stroke="#4DA6FF" StrokeThickness="2"/>

              <TextBlock Canvas.Left="18" Canvas.Top="10" Text="1.0" Foreground="#888" FontSize="10"/>
              <TextBlock Canvas.Left="18" Canvas.Top="133" Text="0.5" Foreground="#888" FontSize="10"/>
              <TextBlock Canvas.Left="24" Canvas.Top="256" Text="0" Foreground="#888" FontSize="10"/>
              <TextBlock Canvas.Left="58" Canvas.Top="20" Text="P(floor time ≤ x)" Foreground="#888" FontSize="10"/>

              <TextBlock Canvas.Left="52" Canvas.Top="268" Text="{Binding MinimumTimeLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Canvas.Right="16" Canvas.Top="268" Text="{Binding MaximumTimeLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Canvas.Left="210" Canvas.Top="282" Text="Floor time (m:ss)" Foreground="#888" FontSize="10"/>
              <Ellipse Canvas.Left="{Binding HoverMarkerLeft}"
                       Canvas.Top="{Binding HoverMarkerTop}"
                       Width="9" Height="9"
                       Fill="White" Stroke="#4DA6FF" StrokeThickness="2"
                       Visibility="{Binding HoverMarkerVisibility}"
                       IsHitTestVisible="False"/>
              <Border Canvas.Left="{Binding HoverCalloutLeft}"
                      Canvas.Top="{Binding HoverCalloutTop}"
                      Width="130" Padding="8,5"
                      Background="#EE252529" BorderBrush="#666" BorderThickness="1"
                      CornerRadius="4" Panel.ZIndex="10"
                      Visibility="{Binding HoverMarkerVisibility}"
                      IsHitTestVisible="False">
                <TextBlock Text="{Binding HoverTooltip}" Foreground="White" FontSize="11"/>
              </Border>
            </Canvas>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:ScatterPlot}">
      <Border Background="#1E1E1E" CornerRadius="8" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Grid Width="480" Height="280" Margin="0,4,0,0">
            <Border Background="#141416"/>
            <TextBlock Text="Room count" Foreground="#888" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            <TextBlock Text="Critical rooms" Foreground="#888" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"/>
            <Canvas Width="480" Height="280">
              <ItemsControl ItemsSource="{Binding Points}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                    <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Ellipse Width="8" Height="8" Fill="#4DA6FF" Opacity="{Binding Intensity}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Stats" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
      <TextBlock Text="{Binding Summary}" Foreground="#888" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                ItemContainerStyle="{StaticResource SectionTabStyle}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TabPanel IsItemsHost="True" Margin="0,0,0,16"/>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>

      <TabItem Header="Room times &amp; CDF">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ListBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   ItemContainerStyle="{StaticResource ThemeButtonStyle}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <ListBox Grid.Row="1" ItemsSource="{Binding RoomTimeCharts}" Style="{StaticResource ChartListStyle}"/>
        </Grid>
      </TabItem>

      <TabItem Header="Miscellaneous">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Key counts, layout and dead ends · Fully completed solo large floors across all themes"
                     Foreground="#999999" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding MiscellaneousCharts}" Style="{StaticResource ChartListStyle}"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
