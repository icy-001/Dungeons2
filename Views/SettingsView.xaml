<UserControl x:Class="Dungeons2.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212" Foreground="#E0E0E0">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Application Settings" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,25"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                <Border Background="#1E1E1E" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="15" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="General" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <CheckBox Content="Run on Windows startup" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Automatically attach to game client when detected" IsChecked="True" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Enable Discord Rich Presence" IsChecked="True" Foreground="#E0E0E0" FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="15" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Data &amp; Storage" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="Floor Logs Export Directory" Foreground="#888" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="C:\Users\DGPlayer\Documents\DungTracker\Logs" Background="#2D2D30" Foreground="White" BorderThickness="0" Padding="8"/>
                            <Button Grid.Column="1" Content="Browse..." Background="#333" Foreground="White" BorderThickness="0" Padding="15,8" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="v1.0.4 - Built for standard resolutions" Foreground="#555" FontSize="12" HorizontalAlignment="Right" Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>