<UserControl x:Class="Dungeons2.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dungeons2">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Application Settings" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,25"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Left">

                <Border Background="#1E1E1E" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Capture Calibration" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <TextBlock Text="Auto-detect the map and HUD positions from the current game capture." Foreground="#888" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Auto-detect" Background="#333" Foreground="White" BorderThickness="0" Padding="15,8" Click="AutoDetectCalibrationButton_Click"/>
                            <TextBlock x:Name="CalibrationStatusText" Foreground="#AAA" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Annotated Map Overlay" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <CheckBox Content="Show opened keydoors"
                                  IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowKeydoors, Mode=TwoWay}"
                                  Foreground="#E0E0E0"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="Show key locations"
                                  IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowKeyLocations, Mode=TwoWay}"
                                  Foreground="#E0E0E0"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="Hide trivial keyblocks"
                                  IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=HideTrivialKeyblocks, Mode=TwoWay}"
                                  Foreground="#E0E0E0"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="Show room ticks"
                                  IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowRoomTicks, Mode=TwoWay}"
                                  Foreground="#E0E0E0"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="Show player visited overlay"
                                  IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=ShowPlayerVisitedOverlay, Mode=TwoWay}"
                                  Foreground="#E0E0E0"
                                  FontSize="14"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Average RPM Targets" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <TextBlock Text="Set the expected RPM targets for solo, duo, trio, 4-man, and 5-man runs." Foreground="#888" Margin="0,0,0,15"/>
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="AverageRpmRowStyle" TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Style="{StaticResource AverageRpmRowStyle}" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Solo" Foreground="#E0E0E0" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=AverageRpms[0], Mode=TwoWay}" Width="80" Background="#2D2D30" Foreground="White" BorderThickness="0" Padding="8" PreviewTextInput="NumberTextBox_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource AverageRpmRowStyle}" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Duo" Foreground="#E0E0E0" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=AverageRpms[1], Mode=TwoWay}" Width="80" Background="#2D2D30" Foreground="White" BorderThickness="0" Padding="8" PreviewTextInput="NumberTextBox_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource AverageRpmRowStyle}" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Trio" Foreground="#E0E0E0" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=AverageRpms[2], Mode=TwoWay}" Width="80" Background="#2D2D30" Foreground="White" BorderThickness="0" Padding="8" PreviewTextInput="NumberTextBox_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource AverageRpmRowStyle}" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="4-man" Foreground="#E0E0E0" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=AverageRpms[3], Mode=TwoWay}" Width="80" Background="#2D2D30" Foreground="White" BorderThickness="0" Padding="8" PreviewTextInput="NumberTextBox_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource AverageRpmRowStyle}" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="5-man" Foreground="#E0E0E0" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=AverageRpms[4], Mode=TwoWay}" Width="80" Background="#2D2D30" Foreground="White" BorderThickness="0" Padding="8" PreviewTextInput="NumberTextBox_PreviewTextInput"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="8" Padding="25" Margin="0,0,0,20" Visibility="{Binding LogSheetsEnabled, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="Spreadsheet Logging" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <CheckBox Content="Log completed floors to Google Sheets"
                                  IsChecked="{Binding Source={x:Static local:Settings.Instance}, Path=LogToSheet, Mode=TwoWay}"
                                  Foreground="#E0E0E0"
                                  FontSize="14"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Spreadsheet ID" Foreground="#888" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=SpreadsheetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D30"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="8"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Target Column" Foreground="#888" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=SpreadsheetColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D30"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="8"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Start Row" Foreground="#888" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Source={x:Static local:Settings.Instance}, Path=SpreadsheetStartRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D30"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="8"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="VersionTextBlock" Foreground="#555" FontSize="12" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
